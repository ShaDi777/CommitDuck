<idea-plugin>
    <id>ru.itmo.commit-duck</id>

    <name>Commit-Duck</name>

    <vendor url="https://github.com/ShaDi777/CommitDuck">#118 Commit Duck</vendor>

    <description><![CDATA[
        Commit Duck is a virtual duck companion for JetBrains IDEs that reacts to your coding activity.
        It cheers you on while you work and dozes off when you take a break.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.vcs</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- If the plugin is published on JetBrains Marketplace, errors reported by users are available on the plugin page.
             See https://plugins.jetbrains.com/docs/marketplace/error-handler.html#developers-side for details. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <toolWindow id="MyToolWindow" factoryClass="ru.itmo.ui.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <toolWindow id="Duck" factoryClass="ru.itmo.ui.DuckToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <statusBarWidgetFactory id="CommitDuck" implementation="ru.itmo.ui.DuckStatusBarWidgetFactory"/>
        <applicationConfigurable parentId="tools" instance="ru.itmo.config.DuckConfigurable"
                                 id="ru.itmo.commit-duck.settings" key="settings.duck.name"/>
        <testStatusListener implementation="ru.itmo.listener.DuckTestListener"/>
        <checkinHandlerFactory implementation="ru.itmo.listener.DuckCommitListener"/>

        <notificationGroup
                id="Commit Duck Achievements"
                displayType="BALLOON"/>
    </extensions>

    <applicationListeners>
        <listener class="ru.itmo.listener.DuckActivityListener" topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
        <listener class="ru.itmo.listener.DuckFileDeleteListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="ru.itmo.listener.DuckBuildListener" topic="com.intellij.openapi.compiler.CompilationStatusListener"/>
    </projectListeners>

</idea-plugin>
